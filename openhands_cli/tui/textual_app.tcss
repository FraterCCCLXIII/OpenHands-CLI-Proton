Screen {
    layout: vertical;
    background: $background;
}

#content_area {
    height: 1fr;
    layout: horizontal;
}

#conversation_state {
    height: 1fr;
    width: 1fr;
    layout: vertical;
    background: $background;
    color: $foreground;
}

#scroll_view {
    height: 1fr;
    margin: 1 1 0 1;
    background: $background;
    color: $foreground;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#splash_content {
    height: auto;
    background: $background;
    color: $foreground;
}

.user-message {
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 1;
    background: $background;
    color: $primary;
}

.help-message, .error-message, .status-message {
    padding: 0 1;
    background: $background;
    color: $foreground;
}

#input_area {
    height: auto;
    max-height: 22;
    background: $background;
    padding: 0 1;
    margin: 0;
}


/* Chat input row - port from prototype */
#chat-input-row {
    margin: 0;
    border: round #8a8a8a;
    background: transparent !important;
    height: auto;
}

#chat-input-row:focus-within {
    border: round #c8c8c8;
    background: transparent !important;
}

#chat-input-row:hover {
    border: round #a0a0a0;
    background: transparent !important;
}

#chat-input-prefix {
    width: auto;
    color: #8a8a8a;
    padding: 0 0 0 1;
    height: auto;
    min-height: 1;
    content-align: left middle;
}

/* Input inside chat row - compact, borderless, transparent (row provides border) */
#chat-input-row InputField {
    width: 1fr;
    min-height: 1;
    height: auto;
}

#chat-input-row #single_line_input,
#chat-input-row #multiline_input {
    border: none !important;
    background: transparent !important;
    color: #f2f2f2;
    padding: 0 1;
    width: 1fr;
    min-height: 1;
    height: auto;
}

#chat-input-row #single_line_input:focus,
#chat-input-row #multiline_input:focus {
    border: none !important;
    background: transparent !important;
    color: white;
}

Footer {
    dock: bottom;
    display: none;
    background: $surface;
    color: $foreground;
}

Footer.-visible {
    display: block;
}

/* Dropdown overlay styles - port from prototype (model/cloud picker) */
#model-picker OptionList,
#cloud-picker OptionList {
    background: transparent;
    color: #f2f2f2;
    border: round #8a8a8a;
}

#model-picker OptionList:hover,
#cloud-picker OptionList:hover {
    border: round #a0a0a0;
}

#model-picker OptionList:focus,
#cloud-picker OptionList:focus {
    border: round #b0b0b0;
}

#model-picker OptionList > .option-list--option-hover,
#cloud-picker OptionList > .option-list--option-hover {
    background: #181818;
    color: #f2f2f2;
}

#model-picker OptionList > .option-list--option-highlighted,
#cloud-picker OptionList > .option-list--option-highlighted {
    background: #2a2a2a;
    color: white;
    text-style: bold;
}

#model-picker OptionList:focus > .option-list--option-highlighted,
#cloud-picker OptionList:focus > .option-list--option-highlighted {
    background: #3a3a3a;
    color: white;
}

/* Panel-like styling for splash screen elements */
.splash-banner {
    padding: 0 1;
    background: $background;
    color: $primary;
    text-align: center;
}

.splash-version {
    padding: 0 1;
    background: $background;
    color: $foreground;
    text-align: center;
    margin-bottom: 1;
}

.status-panel {
    width: auto;
    height: auto;
    background: transparent;
    padding: 0 1;
    text-align: left;
    margin: 0;
}

.conversation-panel {
    width: auto;
    height: auto;
    background: transparent;
    padding: 0 1;
    text-align: left;
    margin: 0;
}

.splash-instruction {
    padding: 0 1;
    background: $background;
    color: $foreground;
    margin: 0;
}

.splash-instruction-header {
    padding: 0 1;
    background: $background;
    color: $primary;
    margin: 1 0 0 0;
}

.splash-update-notice {
    padding: 0 1;
    background: $background;
    color: $primary;
    margin: 1 0 0 0;
}

.splash-critic-notice {
    padding: 0 1;
    background: $background;
    color: $foreground;
    margin: 0;
}